# .gitignore —— 聊天语料和构建产物不进仓库

# 语料与导出（含个人聊天记录，绝对不能提交）
corpus/
deepseek_data-*.zip

# 构建中间产物
android/build/
android/tmp/
android/__pycache__/
tools/__pycache__/
*.class
*.dex

# 运行时 / 工具缓存
.dsh-vision-router/
.dsh/
node_modules/
*.log

# 系统
Thumbs.db
desktop.ini
.DS_Store

# 保留：dist/NightRead.apk（发版用）、prototype/、android/ 源码、docs/
